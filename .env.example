# Postgres connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/ccc_community

# Base64-encoded CA cert, only needed if your Postgres provider requires TLS
# with a custom CA (e.g. managed DB in production)
# DATABASE_CA_CERT=

# Optional: enables the DigitalOcean live pricing pipeline
# DIGITALOCEAN_API_TOKEN=

# Optional: enables the Alibaba Cloud live pricing pipeline
# ALIBABA_ACCESS_KEY_ID=
# ALIBABA_ACCESS_KEY_SECRET=

# Optional: enables the GCP billing catalog pipeline
# GCP_BILLING_API_KEY=

# Optional: if you build your own admin routes on top of this codebase,
# generate with: openssl rand -hex 32
# ADMIN_API_KEY=
